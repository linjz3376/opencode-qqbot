{
  "name": "@linjz/opencode-qqbot",
  "version": "0.3.17",
  "type": "module",
  "description": "QQ Bot for OpenCode AI - chat with AI coding assistant via QQ",
  "exports": {
    ".": "./dist/opencode-qqbot-plugin.js"
  },
  "bin": {
    "openqq": "./bin/openqq.js",
    "openqq-setup": "./bin/openqq-setup.mjs"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/run-tests.mjs",
    "hooks:install": "bun scripts/install-hooks.mjs",
    "test:e2e": "bun run test/watch-history-e2e.ts && bun run test/d1-subagent-ask-e2e.ts && bun run test/d2-conflict-e2e.ts && bun run test/perm-e2e.ts && bun run test/perm-real-e2e.ts",
    "verify": "bun run typecheck && bun run test",
    "verify:full": "bun run verify && bun run test:e2e",
    "build:bundle": "bun build src/index.ts --outfile=dist/openqq-bot.js --target=node",
    "build:notify": "bun build src/cli/notify-main.ts --outfile=dist/notify-cli.js --target=node",
    "build:plugin": "bun build src/plugin-entry.ts --outfile=dist/opencode-qqbot-plugin.js --target=bun --external @opencode/plugin --external effect",
    "build:watchdog": "bun build src/cli/watchdog-main.ts --outfile=dist/openqq-watchdog.js --target=node",
    "build:cli": "bun build src/cli/openqq-main.ts --outfile=dist/openqq-cli.js --target=node",
    "deploy:plugin": "bun run build:bundle && bun run build:notify && bun run build:plugin && bun run build:watchdog && bun run build:cli && bun scripts/deploy-plugin.mjs",
    "prepublishOnly": "bun run build:bundle && bun run build:notify && bun run build:plugin && bun run build:watchdog && bun run build:cli"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "tsconfig.json"
  ],
  "keywords": [
    "opencode-plugin",
    "opencode",
    "qq",
    "qqbot",
    "bot",
    "ai",
    "coding-assistant"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/linjz3376/opencode-qqbot"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.2.20",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.0",
    "effect": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "effect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "effect": "^4.0.0",
    "typescript": "^5.9.0"
  }
}

